{
  "name": "rmatss-mvp",
  "version": "1.0.0",
  "description": "Reinforced Multi-Agent Tutoring System for Schools - MVP",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "wsl sh -c \"cd '/mnt/c/Users/user/PROJET IA/ScholarAI' && node server/index.js\"",
    "client": "cd client && npx cross-env BROWSER=none PORT=3000 npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "db:migrate": "node server/database/migrations/runMigrations.js",
    "db:seed": "node server/database/seeds/seedData.js"
  },
  "keywords": [
    "ai",
    "tutoring",
    "education",
    "multi-agent",
    "reinforcement-learning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "chromadb": "^1.8.1",
    "clamdjs": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "puppeteer-core": "^25.1.0",
    "sequelize": "^6.37.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "sequelize-cli": "^6.6.5"
  }
}
